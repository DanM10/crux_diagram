      "name": "bottom right corner grows",
      "input": {
        "shape": {
          "id": "fixture",
          "type": "rectangle",
          "center": {
            "x": 400.0,
            "y": 300.0
          },
          "size": {
            "width": 200.0,
            "height": 100.0
          },
          "rotation": 0.0
        },
        "handle": "bottomRight",
        "pointer": {
          "x": 550.0,
          "y": 400.0
        },
        "limits": {
          "min": 20.0,
          "max": 1600.0
        }
      },
      "expected": {
