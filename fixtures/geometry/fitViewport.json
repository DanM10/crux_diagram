{
  "function": "fitViewport",
  "description": "Fits the canvas into the area, centered, keeping the aspect ratio (REC-077).",
  "cases": [
    {
      "name": "wider area",
      "input": {
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        }
      },
      "expected": {
        "scale": 0.5,
        "origin": {
          "x": 100.0,
          "y": 0.0
        }
      }
    },
    {
      "name": "taller area",
      "input": {
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 400.0,
          "height": 900.0
        }
      },
      "expected": {
        "scale": 0.25,
        "origin": {
          "x": 0.0,
          "y": 300.0
        }
      }
    },
    {
      "name": "same aspect",
      "input": {
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 800.0,
          "height": 600.0
        }
      },
      "expected": {
        "scale": 0.5,
        "origin": {
          "x": 0.0,
          "y": 0.0
        }
      }
    }
  ]
}
