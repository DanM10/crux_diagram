{
  "function": "visibleCenter",
  "description": "Canvas point under the center of the area, clamped to the canvas (REC-077).",
  "cases": [
    {
      "name": "inside the canvas",
      "input": {
        "viewport": {
          "scale": 0.5,
          "origin": {
            "x": 100.0,
            "y": 0.0
          }
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        },
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        }
      },
      "expected": {
        "x": 800.0,
        "y": 600.0
      }
    },
    {
      "name": "clamped to the canvas",
      "input": {
        "viewport": {
          "scale": 1,
          "origin": {
            "x": -2000.0,
            "y": 0.0
          }
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        },
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        }
      },
      "expected": {
        "x": 1600.0,
        "y": 300.0
      }
    }
  ]
}
