{
  "function": "clampZoom",
  "description": "Pan limited so the canvas covers the area on each larger axis and is centered on each smaller one (REC-077).",
  "cases": [
    {
      "name": "fitted view is centered",
      "input": {
        "zoom": {
          "zoom": 1.0,
          "pan": {
            "dx": 37.0,
            "dy": -12.0
          }
        },
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        }
      },
      "expected": {
        "zoom": 1.0,
        "pan": {
          "dx": 0.0,
          "dy": 0.0
        }
      }
    },
    {
      "name": "zoomed pan inside the limits is kept",
      "input": {
        "zoom": {
          "zoom": 2.0,
          "pan": {
            "dx": -300.0,
            "dy": -200.0
          }
        },
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        }
      },
      "expected": {
        "zoom": 2.0,
        "pan": {
          "dx": -300.0,
          "dy": -200.0
        }
      }
    },
    {
      "name": "zoomed pan past the start is clamped",
      "input": {
        "zoom": {
          "zoom": 2.0,
          "pan": {
            "dx": 500.0,
            "dy": 100.0
          }
        },
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        }
      },
      "expected": {
        "zoom": 2.0,
        "pan": {
          "dx": -200.0,
          "dy": -0.0
        }
      }
    },
    {
      "name": "zoomed pan past the end is clamped",
      "input": {
        "zoom": {
          "zoom": 4.0,
          "pan": {
            "dx": -5000.0,
            "dy": -5000.0
          }
        },
        "canvas": {
          "width": 1600.0,
          "height": 1200.0
        },
        "area": {
          "width": 1000.0,
          "height": 600.0
        }
      },
      "expected": {
        "zoom": 4.0,
        "pan": {
          "dx": -2600.0,
          "dy": -1800.0
        }
      }
    }
  ]
}
