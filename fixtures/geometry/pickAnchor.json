{
  "function": "pickAnchor",
  "description": "Anchor under a point: nearest within the radius, the topmost shape on a tie (REC-077).",
  "cases": [
    {
      "name": "nearest anchor",
      "input": {
        "shapes": [
          {
            "id": "a",
            "type": "rectangle",
            "center": {
              "x": 400.0,
              "y": 300.0
            },
            "size": {
              "width": 200.0,
              "height": 100.0
            },
            "rotation": 0.0
          }
        ],
        "point": {
          "x": 505.0,
          "y": 255.0
        },
        "radius": 24,
        "tieTolerance": 1
