{
  "function": "shapeContains",
  "description": "Whether a shape contains a canvas point, rotation-aware, edges inclusive (REC-077).",
  "cases": [
    {
      "name": "rectangle center",
      "input": {
        "shape": {
          "id": "fixture",
          "type": "rectangle",
          "center": {
            "x": 400.0,
            "y": 300.0
          },
          "size": {
            "width": 200.0,
            "height": 100.0
          },
          "rotation": 0.0
        },
        "point": {
          "x": 400.0,
          "y": 300.0
        }
      },
      "expected": true
    },
    {
      "name": "rectangle inside near a corner",
      "input": {
        "shape": {
          "id": "fixture",
          "type": "rectangle",
          "center": {
            "x": 400.0,
            "y": 300.0
          },
          "size": {
            "width": 200.0,
            "height": 100.0
          },
          "rotation": 0.0
        },
        "point": {
          "x": 495.0,
          "y": 345.0
        }
      },
      "expected": true
    },
    {
      "name": "rectangle edge is inclusive",
      "input": {
        "shape": {
          "id": "fixture",
          "type": "rectangle",
          "center": {
            "x": 400.0,
