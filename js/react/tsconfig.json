{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@diagrama-kit/core": ["../core/src/index.ts"],
      "@diagrama-kit/react": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "e2e", "examples", "stories", ".storybook", "playwright.config.ts"]
}
